# =============================================================================
# Codecarto .gitignore
# =============================================================================

# Secrets & tokens
token.txt
secrets.txt
.env
.env.*

# =============================================================================
# Python
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/
MANIFEST

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.nox/
.tox/
*.pstats

# Type checking
.mypy_cache/
.pytype/

# =============================================================================
# JavaScript / Node
# =============================================================================
node_modules/
.vite/
web/dist/
web/test-results/
web/playwright-report/
web/blob-report/
web/playwright/.cache/

# =============================================================================
# IDE / Editor
# =============================================================================
# Contents rather than the directory: git will not re-include a file whose
# parent directory is excluded, so `.vscode/` would make the negations below
# silently do nothing. The governance seed checks those two files in.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.vs/
*.swp
*.swo
.DS_Store

# =============================================================================
# Documentation
# =============================================================================
site/
docs/_build/
docs/build/

# =============================================================================
# Project specific
# =============================================================================
output/
.dev/
playground/
sandbox/

# Jupyter
.ipynb_checkpoints/

# Docker
docker.sh
dev.sh

# Screenshots cache (mkdocs)
.cache/
.screenshot_cache/

# rad conformance build output
web/dist-rad/

# pure-logic test build output
web/dist-pure/

# The session brief governance/qm/project-seed/ci/cowork_context.py writes for
# the session it is running in. It describes one moment in one clone, so it
# is never committed -- the corpus ignores the same directory for the same reason.
.harness/
